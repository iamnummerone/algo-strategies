//@version=6
indicator("HTF MA Trend (Sanya Setup)", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================

htfTimeframe   = input.timeframe("D", "HTF Timeframe")
maLength       = input.int(50, "MA Length", minval=1, maxval=500)
maSource       = input.source(close, "Price source for MA")
slopeLookback  = input.int(3, "Slope lookback (HTF bars)", minval=1, maxval=20)
minSlopePct    = input.float(0.05, "Min slope per bar (% of price)", minval=0.0, maxval=5.0, step=0.01)
showTrendLine  = input.bool(true, "Show trend line (+1/0/-1)")
showBackground = input.bool(true, "Show background color")
infoBoxOffset  = input.float(1.02, "Info box Y-position multiplier", minval=0.5, maxval=3.0, step=0.01)

// ============================================================================
// HTF DATA
// ============================================================================

// Request HTF data using closed bars only (no repaint)
// Using lookahead=on with gaps_off ensures we get the last closed HTF bar value
htfClose = request.security(syminfo.tickerid, htfTimeframe, maSource, barmerge.gaps_off, barmerge.lookahead_on)

// Calculate Simple Moving Average on HTF data
htfMA = ta.sma(htfClose, maLength)

// ============================================================================
// CORE LOGIC
// ============================================================================

// Calculate MA slope over the specified lookback period
slope = (htfMA - htfMA[slopeLookback]) / slopeLookback

// Convert slope to percentage per bar relative to current MA value
slopePct = na(htfMA) or htfMA == 0.0 ? na : (slope / htfMA) * 100.0

// Determine if slope meets minimum threshold
isBullSlope = slopePct >= minSlopePct
isBearSlope = slopePct <= -minSlopePct

// Determine trend based on price vs MA and slope conditions
trend = if htfClose > htfMA and isBullSlope
    1.0
else if htfClose < htfMA and isBearSlope
    -1.0
else
    0.0

// ============================================================================
// VISUALIZATION
// ============================================================================

// Plot HTF MA line on chart
plot(htfMA, "HTF MA Line", color=color.new(color.blue, 0), linewidth=2)

// Plot trend line (visible on chart with color coding) - optional
trendColor = trend == 1 ? color.green : trend == -1 ? color.red : color.gray
plot(showTrendLine ? trend : na, title="HTF MA Trend Value", color=trendColor, linewidth=3, style=plot.style_line)

// Background coloring
bgColor = showBackground ? 
     (trend == 1 ? color.new(color.green, 85) : 
      trend == -1 ? color.new(color.red, 85) : 
      color.new(color.gray, 90)) : na
bgcolor(bgColor, title="MA Trend Background")

// Status label on the last bar
if barstate.islast
    var label infoLabel = na
    label.delete(infoLabel)
    
    trendText = trend == 1 ? "BULL" : trend == -1 ? "BEAR" : "NEUTRAL"
    sign = slopePct >= 0 ? "+" : ""
    slopeText = na(slopePct) ? "N/A" : sign + str.tostring(slopePct, "#.##") + "%/bar"
    
    txt = "HTF MA Trend (" + htfTimeframe + ", len=" + str.tostring(maLength) + "): " + trendText + 
          "\nSlope: " + slopeText
    
    infoLabel := label.new(x = bar_index, y = high * infoBoxOffset, text = txt, style = label.style_label_down, color = color.new(color.gray, 25), textcolor = color.white, size = size.normal, textalign = text.align_left)

// ============================================================================
// DATA WINDOW / DEBUG
// ============================================================================

// Additional plots for data window (not visible on chart)
plot(trend, "MA Trend (+1/0/-1)", display=display.data_window, color=color.new(color.white, 100))
plot(htfMA, "HTF MA", display=display.data_window)
plot(slopePct, "Slope % per bar", display=display.data_window)

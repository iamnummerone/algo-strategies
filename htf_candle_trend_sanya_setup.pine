//@version=6
indicator("HTF Candle Trend (Sanya Setup)", overlay=true)

// ════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════
htfTimeframe = input.timeframe("D", "HTF Timeframe")
lookback = input.int(5, "Lookback candles", minval=1, maxval=50)
minBodyPct = input.float(0.25, "Min body as % of range", minval=0.0, maxval=1.0, step=0.05)
showBackground = input.bool(true, "Show background color")

// ════════════════════════════════════════════════════════════════════════════
// HTF DATA - CLOSED CANDLES ONLY (NO REPAINTING)
// ════════════════════════════════════════════════════════════════════════════
htfOpen = request.security(syminfo.tickerid, htfTimeframe, open, barmerge.gaps_off, barmerge.lookahead_on)
htfHigh = request.security(syminfo.tickerid, htfTimeframe, high, barmerge.gaps_off, barmerge.lookahead_on)
htfLow = request.security(syminfo.tickerid, htfTimeframe, low, barmerge.gaps_off, barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, barmerge.gaps_off, barmerge.lookahead_on)

// ════════════════════════════════════════════════════════════════════════════
// ANALYZE LAST N CLOSED HTF CANDLES
// ════════════════════════════════════════════════════════════════════════════
bullishCount = 0
bearishCount = 0

for i = 1 to lookback
    htfRange = htfHigh[i] - htfLow[i]
    htfBody = math.abs(htfClose[i] - htfOpen[i])
    
    if htfRange > 0
        bodyRatio = htfBody / htfRange
        
        if bodyRatio >= minBodyPct
            if htfClose[i] > htfOpen[i]
                bullishCount += 1
            else if htfClose[i] < htfOpen[i]
                bearishCount += 1

// ════════════════════════════════════════════════════════════════════════════
// TREND DETERMINATION
// ════════════════════════════════════════════════════════════════════════════
trend = bullishCount > bearishCount ? 1 : bearishCount > bullishCount ? -1 : 0

// ════════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ════════════════════════════════════════════════════════════════════════════
trendColor = trend == 1 ? color.green : trend == -1 ? color.red : color.gray
plot(trend, "HTF Trend", color=trendColor, linewidth=2, style=plot.style_line)

bgColor = showBackground ? (trend == 1 ? color.new(color.green, 90) : trend == -1 ? color.new(color.red, 90) : color.new(color.gray, 95)) : na
bgcolor(bgColor)

if barstate.islast
    trendText = trend == 1 ? "BULL" : trend == -1 ? "BEAR" : "NEUTRAL"
    labelText = "HTF Trend (" + htfTimeframe + "): " + trendText + " [" + str.tostring(bullishCount) + "/" + str.tostring(bearishCount) + "]"
    label.new(bar_index, trend, labelText, style=label.style_label_left, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
